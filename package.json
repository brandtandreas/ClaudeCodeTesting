{
  "name": "chess-trainer",
  "private": true,
  "workspaces": ["packages/*", "frontend", "backend"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=frontend && npm run build --workspace=backend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
